# ==============================================================================
# AI-Based Diabetic Retinopathy Screening Engine - Environment Configuration
# Copy this file to '.env' and adjust paths according to your environment.
# Note: '.env' is ignored by Git to avoid leaking personal paths or credentials.
# ==============================================================================

# Directories & Model Weights
DATASET_DIR=datasets/raw
MODEL_PATH=model/weights/dr_screening_model.mat
OUTPUT_DIR=reports

# CNN Image Dimensions
TARGET_IMAGE_HEIGHT=224
TARGET_IMAGE_WIDTH=224

# Quality Assessment Thresholds
QUALITY_GOOD_THRESH=0.75
QUALITY_BORDERLINE_THRESH=0.50
SHARPNESS_MIN_THRESH=0.28

# Image Enhancement Parameters
CLAHE_CLIP_LIMIT=0.02
DENOISE_METHOD=bilateral

# Clinical Referral Thresholds
REFERABLE_CUTOFF_CLASS=2
CONFIDENCE_MIN_ACCEPTABLE=0.80
